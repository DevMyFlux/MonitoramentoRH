generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "leadership_lab"]
}

enum RoleName {
  DEV
  ADMIN
  RH
  COMUM
  @@schema("public")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  @@schema("public")
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  APPROVE
  REJECT
  PUBLISH
  UNPUBLISH
  OVERRIDE
  ROLE_CHANGE
  PERMISSION_CHANGE
  USER_INVITE
  USER_DISABLE
  @@schema("public")
}

enum ImportType {
  EMPLOYEES
  QLP
  SCHEDULE
  @@schema("public")
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  COMMITTED
  REJECTED
  @@schema("public")
}

enum ImportIssueSeverity {
  ERROR
  WARNING
  @@schema("public")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  VACATION
  TERMINATED
  SCHEDULED_ADMISSION
  @@schema("public")
}

enum QLPKind {
  CONTRACTUAL
  OPERATIONAL
  @@schema("public")
}

enum WorkflowStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  @@schema("public")
}

enum RequirementKind {
  DOCUMENT
  COMPETENCY
  @@schema("public")
}

enum AptitudeStatus {
  GREEN
  YELLOW
  RED
  @@schema("public")
}

enum EvaluationStatus {
  DRAFT
  IN_RH_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
  @@schema("public")
}

enum CalendarEventCategory {
  VACATION
  LEAVE
  TRAINING
  ADMISSION
  TERMINATION
  TIME_OFF
  OTHER
  @@schema("public")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique
  name                 String
  passwordHash         String
  roleId               String               @db.Uuid
  role                 Role                 @relation(fields: [roleId], references: [id])
  isActive             Boolean              @default(true)
  status               RecordStatus         @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdBy            String?              @db.Uuid
  updatedBy            String?              @db.Uuid
  archivedAt           DateTime?
  auditLogs            AuditLog[]
  scopes               UserScope[]
  refreshSessions      RefreshSession[]
  invitationsCreated   UserInvitation[]     @relation("InvitationCreatedBy")
  passwordResetTokens  PasswordResetToken[]
  /// Leadership Lab: relações inversas (campos virtuais do Prisma, sem coluna em "User").
  labParticipante      LabParticipante?
  labPermissoes        LabPermissaoUsuario[]
  labTurmas            LabTurma[]
  @@schema("public")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        RoleName         @unique
  level       Int
  description String
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  archivedAt  DateTime?
  users       User[]
  permissions RolePermission[]
  invitations UserInvitation[]
  @@schema("public")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String
  status      RecordStatus     @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  createdBy   String?          @db.Uuid
  updatedBy   String?          @db.Uuid
  archivedAt  DateTime?
  roles       RolePermission[]
  @@schema("public")
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@schema("public")
}

model UserScope {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id])
  companyId   String?      @db.Uuid
  operationId String?      @db.Uuid
  unitId      String?      @db.Uuid
  company     Company?     @relation(fields: [companyId], references: [id])
  operation   Operation?   @relation(fields: [operationId], references: [id])
  unit        Unit?        @relation(fields: [unitId], references: [id])
  isGlobal    Boolean      @default(false)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  @@index([userId])
  @@index([companyId])
  @@index([operationId])
  @@index([unitId])
  @@schema("public")
}

model Company {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  document   String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  archivedAt DateTime?
  clients    Client[]
  contracts  Contract[]
  units      Unit[]
  operations Operation[]
  scopes     UserScope[]
  @@schema("public")
}

model Client {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  company    Company      @relation(fields: [companyId], references: [id])
  name       String
  document   String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  archivedAt DateTime?
  contracts  Contract[]
  units      Unit[]
  operations Operation[]

  @@index([companyId])
  @@schema("public")
}

model Unit {
  id         String       @id @default(uuid()) @db.Uuid
  companyId  String       @db.Uuid
  company    Company      @relation(fields: [companyId], references: [id])
  clientId   String?      @db.Uuid
  client     Client?      @relation(fields: [clientId], references: [id])
  name       String
  code       String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  archivedAt DateTime?
  operations Operation[]
  scopes     UserScope[]

  @@index([companyId])
  @@index([clientId])
  @@schema("public")
}

model Contract {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id])
  clientId    String       @db.Uuid
  client      Client       @relation(fields: [clientId], references: [id])
  name        String
  code        String?
  startsAt    DateTime?
  endsAt      DateTime?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?
  operations  Operation[]

  @@index([companyId])
  @@index([clientId])
  @@schema("public")
}

model Operation {
  id          String       @id @default(uuid()) @db.Uuid
  companyId   String       @db.Uuid
  company     Company      @relation(fields: [companyId], references: [id])
  clientId    String       @db.Uuid
  client      Client       @relation(fields: [clientId], references: [id])
  contractId  String?      @db.Uuid
  contract    Contract?    @relation(fields: [contractId], references: [id])
  unitId      String       @db.Uuid
  unit        Unit         @relation(fields: [unitId], references: [id])
  name        String
  code        String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?
  services    Service[]
  obligations Obligation[]
  functions   JobFunction[]
  scopes      UserScope[]
  employees   Employee[]
  qlpVersions QLPVersion[]
  positions   Position[]
  requirements ComplianceRequirement[]
  competencyMatrix CompetencyMatrixItem[]
  calendarEvents CalendarEvent[]
  scheduleVersions ScheduleVersion[]
  scheduleDayOverrides ScheduleDayOverride[]

  @@index([companyId])
  @@index([clientId])
  @@index([contractId])
  @@index([unitId])
  @@schema("public")
}

model Service {
  id          String       @id @default(uuid()) @db.Uuid
  operationId String       @db.Uuid
  operation   Operation    @relation(fields: [operationId], references: [id])
  name        String
  code        String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?
  obligations Obligation[]

  @@index([operationId])
  @@schema("public")
}

model Obligation {
  id          String       @id @default(uuid()) @db.Uuid
  operationId String       @db.Uuid
  operation   Operation    @relation(fields: [operationId], references: [id])
  serviceId   String?      @db.Uuid
  service     Service?     @relation(fields: [serviceId], references: [id])
  title       String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  @@index([operationId])
  @@index([serviceId])
  @@schema("public")
}

model JobFunction {
  id          String       @id @default(uuid()) @db.Uuid
  operationId String?      @db.Uuid
  operation   Operation?   @relation(fields: [operationId], references: [id])
  name        String
  code        String?
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?
  employees   Employee[]
  qlpRequirements QLPRequirement[]
  positions   Position[]
  requirements ComplianceRequirement[]
  competencyMatrix CompetencyMatrixItem[]
  /// Leadership Lab: relação inversa (campo virtual do Prisma, sem coluna em "JobFunction").
  labMolde LabMoldeCargo?

  @@index([operationId])
  @@schema("public")
}

model QLPVersion {
  positions Position[]
  id           String           @id @default(uuid()) @db.Uuid
  operationId  String           @db.Uuid
  operation    Operation        @relation(fields: [operationId], references: [id])
  version      Int
  kind         QLPKind
  validFrom    DateTime
  validTo      DateTime?
  reason       String
  status       WorkflowStatus   @default(DRAFT)
  approvedBy   String?          @db.Uuid
  approvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdBy    String?          @db.Uuid
  updatedBy    String?          @db.Uuid
  archivedAt   DateTime?
  requirements QLPRequirement[]

  @@unique([operationId, version, kind])
  @@index([operationId])
  @@index([status])
  @@schema("public")
}

model QLPRequirement {
  id         String      @id @default(uuid()) @db.Uuid
  versionId  String      @db.Uuid
  version    QLPVersion  @relation(fields: [versionId], references: [id])
  functionId String      @db.Uuid
  function   JobFunction @relation(fields: [functionId], references: [id])
  workRegime String?
  shift      String?
  parity     String?
  team       String?
  quantity   Int
  criticality String?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  archivedAt DateTime?

  @@index([versionId])
  @@index([functionId])
  @@schema("public")
}

model Position {
  qlpVersionId String? @db.Uuid
  qlpVersion QLPVersion? @relation(fields: [qlpVersionId], references: [id])
  recruitmentRequests RecruitmentRequest[]
  assignments EmployeeAssignment[]
  id          String       @id @default(uuid()) @db.Uuid
  operationId String       @db.Uuid
  operation   Operation    @relation(fields: [operationId], references: [id])
  functionId  String       @db.Uuid
  function    JobFunction  @relation(fields: [functionId], references: [id])
  workRegime  String?
  shift       String?
  parity      String?
  team        String?
  criticality String?
  validFrom   DateTime
  validTo     DateTime?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  @@index([operationId])
  @@index([functionId])
  @@schema("public")
}

enum EmployeeParity {
  ODD
  EVEN
  @@schema("public")
}

model Employee {
  admissions CandidateApplication[]
  id           String              @id @default(uuid()) @db.Uuid
  operationId  String              @db.Uuid
  operation    Operation           @relation(fields: [operationId], references: [id])
  functionId   String?             @db.Uuid
  function     JobFunction?        @relation(fields: [functionId], references: [id])
  name         String
  identifier   String
  /// Short, manually-entered abbreviation shown on the schedule grid.
  /// Not derived from the name: two employees in the same operation may share initials.
  initials     String              @default("")
  /// Professional council registration (e.g. CREA/CRM), when the role requires one.
  /// Empty on both reference schedules today; kept for future use, never required.
  council      String?
  employmentType String?
  jobTitle     String?
  admissionDate DateTime?
  /// Desligamento (programado ou efetivo): last day the person works. Until this date the
  /// schedule shows them normally; the days after it are blank. Null = no termination planned.
  terminationDate DateTime? @db.Date
  status       EmployeeStatus      @default(ACTIVE)
  workRegime   String?
  shift        String?
  /// Day-of-month rotation group (odd/even calendar day) for 1-on-1-off schedules.
  /// Null for employees on a fixed weekday schedule (e.g. Mon-Fri commercial/admin staff).
  parity       EmployeeParity?
  /// Month (YYYY-MM) in which `parity` is true. The Par/Ímpar classification inverts after
  /// every 31-day month, so the effective parity of another month is derived from this one
  /// (packages/shared/src/parity-rotation.ts). Null = DEFAULT_PARITY_REFERENCE_MONTH (2026-10).
  parityReferenceMonth String?
  team         String?
  notes        String?
  recordStatus RecordStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?             @db.Uuid
  updatedBy    String?             @db.Uuid
  archivedAt   DateTime?
  assignments  EmployeeAssignment[]
  history      EmployeeHistory[]
  documents    EmployeeDocument[]
  competencies EmployeeCompetency[]
  evaluations  EmployeeEvaluation[]
  developmentPlans DevelopmentPlan[]
  calendarEvents CalendarEvent[]
  scheduleDayOverrides ScheduleDayOverride[]
  /// Leadership Lab: relação inversa (campo virtual do Prisma, sem coluna em "Employee").
  labParticipante LabParticipante?

  @@unique([operationId, identifier])
  @@index([operationId])
  @@index([functionId])
  @@index([status])
  @@schema("public")
}

/// Manual, per-employee, per-day correction applied on top of the automatically
/// generated schedule (e.g. an ad-hoc coverage swap or an extra day off that
/// follows no rule). Populated from Fase 6 (geração da escala) onward.
model ScheduleDayOverride {
  id          String       @id @default(uuid()) @db.Uuid
  operationId String       @db.Uuid
  operation   Operation    @relation(fields: [operationId], references: [id])
  employeeId  String       @db.Uuid
  employee    Employee     @relation(fields: [employeeId], references: [id])
  date        DateTime     @db.Date
  /// Schedule letter code, validated against the shared catalog (packages/shared/schedule-codes).
  code        String
  reason      String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String       @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  @@unique([operationId, employeeId, date])
  @@index([operationId])
  @@index([employeeId])
  @@index([date])
  @@schema("public")
}

model ComplianceRequirement {
  id           String          @id @default(uuid()) @db.Uuid
  operationId  String?         @db.Uuid
  operation    Operation?      @relation(fields: [operationId], references: [id])
  functionId   String?         @db.Uuid
  function     JobFunction?    @relation(fields: [functionId], references: [id])
  kind         RequirementKind
  code         String
  name         String
  description  String?
  validityDays Int?
  warningDays  Int            @default(30)
  required     Boolean        @default(true)
  status       RecordStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    String?        @db.Uuid
  updatedBy    String?        @db.Uuid
  archivedAt   DateTime?
  documents    EmployeeDocument[]

  @@unique([operationId, functionId, kind, code])
  @@index([operationId])
  @@index([functionId])
  @@index([kind])
  @@schema("public")
}

model EmployeeDocument {
  id             String                @id @default(uuid()) @db.Uuid
  employeeId     String                @db.Uuid
  employee       Employee              @relation(fields: [employeeId], references: [id])
  requirementId  String                @db.Uuid
  requirement    ComplianceRequirement @relation(fields: [requirementId], references: [id])
  issuedAt       DateTime?
  expiresAt      DateTime?
  fileName       String?
  fileUrl        String?
  notes          String?
  status         RecordStatus          @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      String?               @db.Uuid
  updatedBy      String?               @db.Uuid
  archivedAt     DateTime?

  @@index([employeeId])
  @@index([requirementId])
  @@index([expiresAt])
  @@schema("public")
}

model CompetencyMatrixItem {
  id            String       @id @default(uuid()) @db.Uuid
  operationId   String?      @db.Uuid
  operation     Operation?   @relation(fields: [operationId], references: [id])
  functionId    String       @db.Uuid
  function      JobFunction  @relation(fields: [functionId], references: [id])
  competencyCode String
  competencyName String
  requiredLevel Int          @default(1)
  validityDays  Int?
  warningDays   Int          @default(30)
  required      Boolean      @default(true)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?      @db.Uuid
  updatedBy     String?      @db.Uuid
  archivedAt    DateTime?

  @@unique([operationId, functionId, competencyCode])
  @@index([operationId])
  @@index([functionId])
  @@schema("public")
}

model EmployeeCompetency {
  id             String       @id @default(uuid()) @db.Uuid
  employeeId     String       @db.Uuid
  employee       Employee     @relation(fields: [employeeId], references: [id])
  competencyCode String
  competencyName String
  level          Int          @default(1)
  achievedAt     DateTime?
  expiresAt      DateTime?
  notes          String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?      @db.Uuid
  updatedBy      String?      @db.Uuid
  archivedAt     DateTime?

  @@index([employeeId])
  @@index([competencyCode])
  @@index([expiresAt])
  @@schema("public")
}

model ScheduleVersion {
  id           String           @id @default(uuid()) @db.Uuid
  operationId  String           @db.Uuid
  operation    Operation        @relation(fields: [operationId], references: [id])
  version      Int
  month        DateTime
  status       WorkflowStatus   @default(DRAFT)
  generatedInput Json
  generatedResult Json
  approvedBy   String?          @db.Uuid
  approvedAt   DateTime?
  publishedBy  String?          @db.Uuid
  publishedAt  DateTime?
  overrideJustification String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdBy    String?          @db.Uuid
  updatedBy    String?          @db.Uuid
  archivedAt   DateTime?
  assignments  ScheduleAssignment[]
  history      ScheduleHistory[]

  @@unique([operationId, version, month])
  @@index([operationId])
  @@index([status])
  @@index([month])
  @@schema("public")
}

model ScheduleAssignment {
  id              String          @id @default(uuid()) @db.Uuid
  scheduleId      String          @db.Uuid
  schedule        ScheduleVersion @relation(fields: [scheduleId], references: [id])
  positionId      String
  employeeId      String
  ruleBroken      Boolean         @default(false)
  justification   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?         @db.Uuid
  updatedBy       String?         @db.Uuid

  @@index([scheduleId])
  @@index([employeeId])
  @@index([positionId])
  @@schema("public")
}

model ScheduleHistory {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String          @db.Uuid
  schedule   ScheduleVersion @relation(fields: [scheduleId], references: [id])
  action     String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime        @default(now())
  createdBy  String?         @db.Uuid

  @@index([scheduleId])
  @@schema("public")
}

model EventType {
  id          String                @id @default(uuid()) @db.Uuid
  code        String                @unique
  name        String
  category    CalendarEventCategory
  blocksAvailability Boolean        @default(true)
  requiresApproval   Boolean        @default(false)
  status      RecordStatus          @default(ACTIVE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  createdBy   String?               @db.Uuid
  updatedBy   String?               @db.Uuid
  archivedAt  DateTime?
  events      CalendarEvent[]
  @@schema("public")
}

model CalendarEvent {
  id          String       @id @default(uuid()) @db.Uuid
  typeId      String       @db.Uuid
  type        EventType    @relation(fields: [typeId], references: [id])
  employeeId  String?      @db.Uuid
  employee    Employee?    @relation(fields: [employeeId], references: [id])
  operationId String?      @db.Uuid
  operation   Operation?   @relation(fields: [operationId], references: [id])
  title       String
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean      @default(false)
  notes       String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  @@index([typeId])
  @@index([employeeId])
  @@index([operationId])
  @@index([startsAt, endsAt])
  @@schema("public")
}

model EvaluationCriterion {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique
  name        String
  description String?
  weight      Int          @default(1)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?      @db.Uuid
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?
  scores      EvaluationScore[]
  @@schema("public")
}

model EmployeeEvaluation {
  id          String            @id @default(uuid()) @db.Uuid
  employeeId  String            @db.Uuid
  employee    Employee          @relation(fields: [employeeId], references: [id])
  title       String
  periodStart DateTime
  periodEnd   DateTime
  status      EvaluationStatus  @default(DRAFT)
  notes       String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?           @db.Uuid
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String?           @db.Uuid
  updatedBy   String?           @db.Uuid
  archivedAt  DateTime?
  scores      EvaluationScore[]
  history     EvaluationHistory[]
  developmentPlans DevelopmentPlan[]

  @@index([employeeId])
  @@index([status])
  @@schema("public")
}

model EvaluationScore {
  id           String              @id @default(uuid()) @db.Uuid
  evaluationId String              @db.Uuid
  evaluation   EmployeeEvaluation  @relation(fields: [evaluationId], references: [id])
  criterionId  String              @db.Uuid
  criterion    EvaluationCriterion @relation(fields: [criterionId], references: [id])
  score        Int
  comment      String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?             @db.Uuid
  updatedBy    String?             @db.Uuid

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
  @@index([criterionId])
  @@schema("public")
}

model DevelopmentPlan {
  id           String              @id @default(uuid()) @db.Uuid
  employeeId   String              @db.Uuid
  employee     Employee            @relation(fields: [employeeId], references: [id])
  evaluationId String?             @db.Uuid
  evaluation   EmployeeEvaluation? @relation(fields: [evaluationId], references: [id])
  title        String
  description  String?
  status       WorkflowStatus      @default(DRAFT)
  dueAt        DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  createdBy    String?             @db.Uuid
  updatedBy    String?             @db.Uuid
  archivedAt   DateTime?
  items        DevelopmentPlanItem[]

  @@index([employeeId])
  @@index([evaluationId])
  @@index([status])
  @@schema("public")
}

model DevelopmentPlanItem {
  id          String          @id @default(uuid()) @db.Uuid
  planId      String          @db.Uuid
  plan        DevelopmentPlan @relation(fields: [planId], references: [id])
  action      String
  owner       String?
  dueAt       DateTime?
  completedAt DateTime?
  status      RecordStatus    @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdBy   String?         @db.Uuid
  updatedBy   String?         @db.Uuid
  archivedAt  DateTime?

  @@index([planId])
  @@schema("public")
}

model EvaluationHistory {
  id           String             @id @default(uuid()) @db.Uuid
  evaluationId String             @db.Uuid
  evaluation   EmployeeEvaluation @relation(fields: [evaluationId], references: [id])
  action       String
  before       Json?
  after        Json?
  reason       String?
  createdAt    DateTime           @default(now())
  createdBy    String?            @db.Uuid

  @@index([evaluationId])
  @@schema("public")
}

model EmployeeAssignment {
  position Position? @relation(fields: [positionId], references: [id])
  id         String       @id @default(uuid()) @db.Uuid
  employeeId String       @db.Uuid
  employee   Employee     @relation(fields: [employeeId], references: [id])
  positionId String?      @db.Uuid
  startsAt   DateTime
  endsAt     DateTime?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  archivedAt DateTime?

  @@index([employeeId])
  @@index([positionId])
  @@schema("public")
}

model EmployeeHistory {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  createdBy  String?  @db.Uuid

  @@index([employeeId])
  @@schema("public")
}

model ImportBatch {
  id            String       @id @default(uuid()) @db.Uuid
  type          ImportType
  status        ImportStatus @default(UPLOADED)
  fileName      String
  fileSize      Int
  checksum      String
  acceptedCount Int          @default(0)
  rejectedCount Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String?      @db.Uuid
  updatedBy     String?      @db.Uuid
  archivedAt    DateTime?
  rows          ImportRow[]
  issues        ImportIssue[]

  @@index([type])
  @@index([status])
  @@index([checksum])
  @@schema("public")
}

model ImportRow {
  id        String      @id @default(uuid()) @db.Uuid
  batchId   String      @db.Uuid
  batch     ImportBatch @relation(fields: [batchId], references: [id])
  rowNumber Int
  raw       Json
  mapped    Json
  createdAt DateTime    @default(now())

  @@index([batchId])
  @@schema("public")
}

model ImportIssue {
  id        String              @id @default(uuid()) @db.Uuid
  batchId   String              @db.Uuid
  batch     ImportBatch         @relation(fields: [batchId], references: [id])
  rowNumber Int?
  field     String?
  value     String?
  code      String
  severity  ImportIssueSeverity
  message   String
  createdAt DateTime            @default(now())

  @@index([batchId])
  @@index([severity])
  @@schema("public")
}

model RefreshSession {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @db.Uuid
  user         User         @relation(fields: [userId], references: [id])
  tokenHash    String       @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdBy    String?      @db.Uuid
  updatedBy    String?      @db.Uuid
  archivedAt   DateTime?

  @@index([userId])
  @@schema("public")
}

model UserInvitation {
  id          String       @id @default(uuid()) @db.Uuid
  email       String
  name        String
  roleId      String       @db.Uuid
  role        Role         @relation(fields: [roleId], references: [id])
  scopes      Json
  tokenHash   String       @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String       @db.Uuid
  createdBy   User         @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  updatedBy   String?      @db.Uuid
  archivedAt  DateTime?

  @@index([email])
  @@index([createdById])
  @@schema("public")
}

model PasswordResetToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  user       User         @relation(fields: [userId], references: [id])
  tokenHash  String       @unique
  expiresAt  DateTime
  usedAt     DateTime?
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?      @db.Uuid
  updatedBy  String?      @db.Uuid
  archivedAt DateTime?

  @@index([userId])
  @@schema("public")
}

model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @db.Uuid
  user          User?       @relation(fields: [userId], references: [id])
  userRole      RoleName?
  action        AuditAction
  entity        String
  entityId      String?
  companyId     String?     @db.Uuid
  operationId   String?     @db.Uuid
  unitId        String?     @db.Uuid
  before        Json?
  after         Json?
  justification String?
  origin        String
  createdAt     DateTime    @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@schema("public")
}

enum AdmissionStage {
  REQUESTED
  RECRUITING
  SELECTED
  DOCUMENTATION
  MEDICAL_EXAM
  ADMISSION_SCHEDULED
  ADMITTED
  WITHDRAWN
  CANCELLED
  @@schema("public")
}
model RecruitmentRequest {
  id String @id @default(uuid()) @db.Uuid
  positionId String @db.Uuid
  position Position @relation(fields: [positionId], references: [id])
  reason String
  desiredDate DateTime
  status String @default("REQUESTED")
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  applications CandidateApplication[]
  @@index([positionId, status])
  @@schema("public")
}
model CandidateApplication {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  request RecruitmentRequest @relation(fields: [requestId], references: [id])
  name String
  email String?
  stage AdmissionStage @default(REQUESTED)
  admissionDate DateTime?
  documentsChecked Boolean @default(false)
  medicalCleared Boolean @default(false)
  employeeId String? @unique @db.Uuid
  employee Employee? @relation(fields: [employeeId], references: [id])
  revision Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history RecruitmentStageHistory[]
  @@index([requestId, stage])
  @@schema("public")
}
model RecruitmentStageHistory {
  id String @id @default(uuid()) @db.Uuid
  applicationId String @db.Uuid
  application CandidateApplication @relation(fields: [applicationId], references: [id])
  fromStage AdmissionStage?
  toStage AdmissionStage
  reason String
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  @@index([applicationId])
  @@schema("public")
}
model OperationalParameter {
  id String @id @default(uuid()) @db.Uuid
  operationId String @db.Uuid
  kind String
  code String
  name String
  configuration Json
  revision Int @default(1)
  status RecordStatus @default(ACTIVE)
  createdBy String @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([operationId, kind, code])
  @@schema("public")
}

// =============================================================================
// Leadership Lab — schema PostgreSQL "leadership_lab".
//
// O que o Prisma não expressa (CHECK, índices parciais, view, dados iniciais)
// está em migrations/0015_leadership_lab/migration.sql. Valores fechados são
// TEXT + CHECK (não enums do Postgres), como pede a documentação do módulo; as
// listas oficiais ficam em packages/shared/src/leadership-lab.ts e um teste de
// integração confere que o banco e o código dizem a mesma coisa.
//
// Colunas de ator (criadoPor, validadoPor, tratadoPor, decididoPor...) são UUID
// de "User" sem FK, a mesma convenção de createdBy/updatedBy do restante do
// repositório; a trilha completa fica em "AuditLog".
//
// O schema "leadership_lab_ia" (sessões do ADK) é criado pela migration, mas
// suas tabelas pertencem ao serviço de IA e não são modeladas aqui.
// =============================================================================

/// As 8 skills do piloto (4 hard e 4 soft). O id é um slug estável, ex.: "gestao-os".
model LabSkill {
  id     String  @id
  nome   String
  tipo   String
  ativo  Boolean @default(true)
  turnos LabTurnoSkill[]
  perfis LabPerfilSkill[]
  alertas LabAlerta[]

  @@map("skill")
  @@schema("leadership_lab")
}

/// Molde por nível de liderança. Nasce inativo: só ativa com tempo limite definido.
model LabMolde {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nivel           String   @unique
  nome            String
  temas           Json     @default("[]")
  numeroSituacoes Int      @default(5) @map("numero_situacoes")
  tempoLimiteS    Int?     @map("tempo_limite_s")
  ativo           Boolean  @default(false)
  atualizadoPor   String?  @map("atualizado_por") @db.Uuid
  criadoEm        DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  cargos          LabMoldeCargo[]
  sessoes         LabSessao[]

  @@map("molde")
  @@schema("leadership_lab")
}

/// Cargo do RH (JobFunction) → molde. Uma função pertence a no máximo um molde.
model LabMoldeCargo {
  jobFunctionId String      @id @map("job_function_id") @db.Uuid
  jobFunction   JobFunction @relation(fields: [jobFunctionId], references: [id])
  moldeId       String      @map("molde_id") @db.Uuid
  molde         LabMolde    @relation(fields: [moldeId], references: [id])
  criadoPor     String?     @map("criado_por") @db.Uuid
  criadoEm      DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([moldeId])
  @@map("molde_cargo")
  @@schema("leadership_lab")
}

/// Liga um login (User) a um colaborador (Employee). Todas as tabelas do módulo
/// apontam para cá, então "User" e "Employee" ganham um único campo virtual cada.
model LabParticipante {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  employeeId String   @unique @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id])
  ativo      Boolean  @default(true)
  criadoPor  String?  @map("criado_por") @db.Uuid
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  turmas     LabTurmaParticipante[]
  termos     LabTermoAceite[]
  sessoes    LabSessao[]
  perfilSkills LabPerfilSkill[]

  @@map("participante")
  @@schema("leadership_lab")
}

/// Permissão por usuário: lab_gestao ou lab_especialista. Revogar = apagar a linha
/// (o histórico fica em AuditLog, ação PERMISSION_CHANGE).
model LabPermissaoUsuario {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  permissao   String
  concedidaPor String? @map("concedida_por") @db.Uuid
  concedidaEm DateTime @default(now()) @map("concedida_em") @db.Timestamptz(3)

  @@unique([userId, permissao])
  @@map("permissao_usuario")
  @@schema("leadership_lab")
}

model LabTurma {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String
  curadorId     String   @map("curador_id") @db.Uuid
  curador       User     @relation(fields: [curadorId], references: [id])
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  participantes LabTurmaParticipante[]

  @@index([curadorId])
  @@map("turma")
  @@schema("leadership_lab")
}

model LabTurmaParticipante {
  turmaId        String          @map("turma_id") @db.Uuid
  turma          LabTurma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  participanteId String          @map("participante_id") @db.Uuid
  participante   LabParticipante @relation(fields: [participanteId], references: [id])
  adicionadoEm   DateTime        @default(now()) @map("adicionado_em") @db.Timestamptz(3)

  @@id([turmaId, participanteId])
  @@index([participanteId])
  @@map("turma_participante")
  @@schema("leadership_lab")
}

/// Termo de ciência versionado, aceito no primeiro acesso.
model LabTermoAceite {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participanteId String          @map("participante_id") @db.Uuid
  participante   LabParticipante @relation(fields: [participanteId], references: [id])
  versaoTermo    String          @map("versao_termo")
  aceitoEm       DateTime        @default(now()) @map("aceito_em") @db.Timestamptz(3)

  @@unique([participanteId, versaoTermo])
  @@map("termo_aceite")
  @@schema("leadership_lab")
}

/// Um teste. Modo "validado" e teste_versao_id entram na versão 1.
model LabSessao {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participanteId String          @map("participante_id") @db.Uuid
  participante   LabParticipante @relation(fields: [participanteId], references: [id])
  moldeId        String          @map("molde_id") @db.Uuid
  molde          LabMolde        @relation(fields: [moldeId], references: [id])
  modo           String          @default("dinamico")
  /// Identificador opaco da conversa no serviço de IA. Nunca é o id do usuário.
  iaSessaoId     String?         @unique @map("ia_sessao_id")
  /// A versão da rubrica com que o teste foi conduzido, e a dificuldade-base que o histórico sugeriu.
  rubricaVersao  String?         @map("rubrica_versao")
  dificuldade    Int?            @db.SmallInt
  status         String          @default("em_andamento")
  iniciadaEm     DateTime        @default(now()) @map("iniciada_em") @db.Timestamptz(3)
  concluidaEm    DateTime?       @map("concluida_em") @db.Timestamptz(3)
  turnos         LabTurno[]
  resultado      LabResultado?
  perfilSkills   LabPerfilSkill[]
  alertas        LabAlerta[]
  contribuicoes  LabContribuicao[]
  logsIa         LabLogIa[]

  @@index([participanteId, iniciadaEm(sort: Desc)])
  @@index([status])
  @@map("sessao")
  @@schema("leadership_lab")
}

/// Cada situação do teste. Aderência, estilo, skills e alerta ficam aqui, mas
/// nunca saem do backend durante o teste.
model LabTurno {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessaoId        String    @map("sessao_id") @db.Uuid
  sessao          LabSessao @relation(fields: [sessaoId], references: [id])
  numero          Int
  marco           Boolean   @default(false)
  texto           String
  opcoes          Json
  estiloAdequado  String    @map("estilo_adequado")
  apresentadaEm   DateTime  @default(now()) @map("apresentada_em") @db.Timestamptz(3)
  respondidaEm    DateTime? @map("respondida_em") @db.Timestamptz(3)
  escolha         String?
  tempoRespostaMs Int?      @map("tempo_resposta_ms")
  tempoEsgotado   Boolean   @default(false) @map("tempo_esgotado")
  aderencia       Int?
  estilo          String?
  alerta          String?
  justificativa   String?
  consequencia    String?
  /// Texto já tratado pela Guarda. Texto bloqueado nunca é gravado.
  textoLivre      String?   @map("texto_livre")
  decisaoGuarda   String?   @map("decisao_guarda")
  /// Reserva enquanto a IA é consultada para este turno. Nulo = ninguém processando;
  /// vencida = quem reservou morreu e outra requisição pode assumir.
  processandoAte  DateTime? @map("processando_ate") @db.Timestamptz(3)
  /// Competências, dificuldade e fontes da situação, e se ela é validada ou experimental.
  basePedagogica  Json?     @map("base_pedagogica")
  fundamentacao   String?
  skills          LabTurnoSkill[]
  alertas         LabAlerta[]
  contribuicao    LabContribuicao?

  @@unique([sessaoId, numero])
  @@map("turno")
  @@schema("leadership_lab")
}

/// Skills ligadas a uma escolha (N:N, com FK para a skill).
model LabTurnoSkill {
  turnoId String   @map("turno_id") @db.Uuid
  turno   LabTurno @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  skillId String   @map("skill_id")
  skill   LabSkill @relation(fields: [skillId], references: [id])

  @@id([turnoId, skillId])
  @@index([skillId])
  @@map("turno_skill")
  @@schema("leadership_lab")
}

/// Fechamento do teste. Os números vêm do backend; o texto, da IA.
model LabResultado {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessaoId              String    @unique @map("sessao_id") @db.Uuid
  sessao                LabSessao @relation(fields: [sessaoId], references: [id])
  aderenciaGeral        Float     @map("aderencia_geral")
  agilidade             Float
  estiloPredominante    String?   @map("estilo_predominante")
  flexibilidadePct      Float?    @map("flexibilidade_pct")
  flexibilidade         String?
  niveisPorSkill        Json      @default("{}") @map("niveis_por_skill")
  resumo                String
  pontoForte            String?   @map("ponto_forte")
  pontoDesenvolvimento  String?   @map("ponto_desenvolvimento")
  sugestoes             Json      @default("[]")
  respostaIa            Json      @map("resposta_ia")
  /// Alguma situação do teste era experimental: o resultado não vale como oficial.
  experimental          Boolean   @default(false)
  statusValidacao       String    @default("aguardando_validacao") @map("status_validacao")
  validadoPor           String?   @map("validado_por") @db.Uuid
  validadoEm            DateTime? @map("validado_em") @db.Timestamptz(3)
  justificativaValidacao String?  @map("justificativa_validacao")
  criadoEm              DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  contestacoes          LabContestacao[]

  @@map("resultado")
  @@schema("leadership_lab")
}

/// Histórico do nível por skill: uma linha nova a cada resultado.
/// "nivel" é o calculado pelo backend; "nivelValidado" é o definido pelo curador.
model LabPerfilSkill {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participanteId String          @map("participante_id") @db.Uuid
  participante   LabParticipante @relation(fields: [participanteId], references: [id])
  skillId        String          @map("skill_id")
  skill          LabSkill        @relation(fields: [skillId], references: [id])
  sessaoId       String          @map("sessao_id") @db.Uuid
  sessao         LabSessao       @relation(fields: [sessaoId], references: [id])
  nivel          Int
  nEvidencias    Int             @map("n_evidencias")
  validado       Boolean         @default(false)
  nivelValidado  Int?            @map("nivel_validado")
  criadoEm       DateTime        @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@unique([sessaoId, skillId])
  @@index([participanteId, skillId, criadoEm(sort: Desc)])
  @@map("perfil_skill")
  @@schema("leadership_lab")
}

/// Vermelho: escolha com aderência 10 (turnoId). Amarelo: skill com média abaixo
/// de 50 em dois testes seguidos (skillId). Alertas são pedagógicos, não disciplinares.
model LabAlerta {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessaoId   String    @map("sessao_id") @db.Uuid
  sessao     LabSessao @relation(fields: [sessaoId], references: [id])
  turnoId    String?   @map("turno_id") @db.Uuid
  turno      LabTurno? @relation(fields: [turnoId], references: [id], onDelete: Restrict)
  cor        String
  skillId    String?   @map("skill_id")
  skill      LabSkill? @relation(fields: [skillId], references: [id], onDelete: Restrict)
  status     String    @default("aberto")
  tratadoPor String?   @map("tratado_por") @db.Uuid
  tratadoEm  DateTime? @map("tratado_em") @db.Timestamptz(3)
  nota       String?
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([status, cor])
  @@index([sessaoId])
  @@map("alerta")
  @@schema("leadership_lab")
}

/// Ideia que melhora o procedimento; entra na fila do curador.
model LabContribuicao {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessaoId   String    @map("sessao_id") @db.Uuid
  sessao     LabSessao @relation(fields: [sessaoId], references: [id])
  turnoId    String    @unique @map("turno_id") @db.Uuid
  turno      LabTurno  @relation(fields: [turnoId], references: [id])
  texto      String
  status     String    @default("pendente")
  decididoPor String?  @map("decidido_por") @db.Uuid
  decididoEm DateTime? @map("decidido_em") @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([status])
  @@index([sessaoId])
  @@map("contribuicao")
  @@schema("leadership_lab")
}

model LabContestacao {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultadoId  String       @map("resultado_id") @db.Uuid
  resultado    LabResultado @relation(fields: [resultadoId], references: [id])
  ponto        String
  motivo       String
  status       String       @default("pendente")
  decididoPor  String?      @map("decidido_por") @db.Uuid
  decididoEm   DateTime?    @map("decidido_em") @db.Timestamptz(3)
  notaDecisao  String?      @map("nota_decisao")
  criadoEm     DateTime     @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([status])
  @@index([resultadoId])
  @@map("contestacao")
  @@schema("leadership_lab")
}

/// Uma linha por chamada à IA. Não guarda conteúdo, só metadados de auditoria e custo.
model LabLogIa {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agente           String
  versaoInstrucao  String     @map("versao_instrucao")
  modelo           String
  tokensEntrada    Int?       @map("tokens_entrada")
  tokensSaida      Int?       @map("tokens_saida")
  latenciaMs       Int        @map("latencia_ms")
  sucesso          Boolean
  codigoErro       String?    @map("codigo_erro")
  sessaoId         String?    @map("sessao_id") @db.Uuid
  sessao           LabSessao? @relation(fields: [sessaoId], references: [id])
  criadoEm         DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([criadoEm])
  @@index([sessaoId])
  @@map("log_ia")
  @@schema("leadership_lab")
}
