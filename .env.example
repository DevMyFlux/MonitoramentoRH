NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3333/api/v1
# Só para desenvolvimento local, em apps/web/.env.local (não aqui): entra direto como o usuário DEV
# do seed, sem passar pelo /login. Qualquer build de produção ignora, mesmo com a variável definida.
# VITE_DEV_AUTO_LOGIN=true
DATABASE_URL=postgresql://my_flux:my_flux@localhost:5432/my_flux?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
THE_ODDS_API_KEY=change-me-odds-api-key

# Leadership Lab. O módulo só liga se LAB_IA_URL estiver definida; ligado, as demais são validadas na
# subida do servidor. LAB_TOLERANCIA_TEMPO_S não tem valor padrão: é decisão do negócio quantos
# segundos de latência de rede são descontados do tempo de resposta (0 = nada).
# LAB_IA_URL=
# LAB_IA_TOKEN=
# LAB_TOLERANCIA_TEMPO_S=
# LAB_LIMITE_TESTES_DIA=
# LAB_IA_TIMEOUT_MS=25000
