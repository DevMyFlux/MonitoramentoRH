NODE_ENV=development
PORT=3333
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3333/api/v1
# MODO DE TESTE (só demonstração local; DESLIGADO por padrão): com a linha abaixo ativa o front não
# pede login e todo visitante entra como o usuário DEV do seed. Nunca usar com dados reais.
# VITE_MODO_TESTE_SEM_LOGIN=true
DATABASE_URL=postgresql://my_flux:my_flux@localhost:5432/my_flux?schema=public
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
THE_ODDS_API_KEY=change-me-odds-api-key

# Leadership Lab. O módulo só liga se LAB_IA_URL estiver definida; ligado, as demais são validadas na
# subida do servidor. LAB_TOLERANCIA_TEMPO_S não tem valor padrão: é decisão do negócio quantos
# segundos de latência de rede são descontados do tempo de resposta (0 = nada).
# MODO DEMONSTRAÇÃO (só sem LAB_IA_URL): com LAB_MODO_DEMO=true o Lab roda com uma IA de exemplo e prepara a
# conta comum@myflux.local como participante. Desligado por padrão. Veja docs/leadership-lab.md.
# LAB_MODO_DEMO=true
# LAB_IA_URL=
# LAB_IA_TOKEN=
# LAB_TOLERANCIA_TEMPO_S=
# LAB_LIMITE_TESTES_DIA=
# LAB_IA_TIMEOUT_MS=25000
# cloud-run = o serviço de IA está no Cloud Run sem acesso público; o site manda o ID token da própria conta.
# LAB_IA_AUTENTICACAO=cloud-run

# Treinamentos Interativos: tentativas que um participante pode iniciar por dia (fuso de São Paulo).
# Sem a variável, não há limite (decisão em aberto com o jurídico).
# TREINO_LIMITE_TENTATIVAS_DIA=3
